APP_NAME=Aashan
ENVIRONMENT=development

MOCK_MODE=true

SETU_BASE_URL=https://fiu-sandbox.setu.co
SETU_AUTH_BASE_URL=https://accountservice.setu.co
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
SETU_AUTO_FETCH=false

REDIRECT_URL=
WEBHOOK_BASE_URL=

# Webhook authentication. Configure at least one before MOCK_MODE=false, or the
# endpoint refuses every request. AA_WEBHOOK_SECRET is preferred: it signs the
# body and bounds replay. Generate with: openssl rand -hex 32
AA_WEBHOOK_TOKEN=
AA_WEBHOOK_SECRET=
WEBHOOK_REPLAY_WINDOW_SECONDS=300
CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://localhost:8000

AASHAN_ENABLE_EMBEDDINGS=true
AASHAN_EMBEDDING_THRESHOLD=0.55

DATABASE_URL=sqlite:///./aashan.db

# Supabase Auth. Keep service-role credentials server-side only.
AUTH_REQUIRED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=
